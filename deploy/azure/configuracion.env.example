# Copiar los nombres y valores en las variables de entorno de App Service.
# Este archivo es una referencia, Spring Boot no lo carga automáticamente.
SPRING_PROFILES_ACTIVE=sqlserver,produccion
DB_URL=jdbc:sqlserver://SERVIDOR.database.windows.net:1433;databaseName=Ensename;encrypt=true;trustServerCertificate=false;loginTimeout=30
DB_USERNAME=ensename_app
DB_PASSWORD=CONFIGURAR_SOLO_EN_AZURE
SERVER_ADDRESS=0.0.0.0
